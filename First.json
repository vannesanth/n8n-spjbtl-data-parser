      "name": "07 Gabung Hasil"
    },
    {
      "parameters": {
        "jsCode": "// Ambil semua item dari node sebelumnya\nconst rows = $input.all().map((item) => item.json);\nconst lengkap = rows.filter((r) => r.status === 'Lengkap').length;\nconst perlu = rows.length - lengkap;\nconst tanggal = $now.setLocale('id').toFormat('d LLLL yyyy');\n\n// Satu baris tabel per permohonan\nconst baris = rows.map((r) =>\n  `<tr><td>${r.no_agenda}</td><td>${r.nama}</td><td>${r.layanan}</td>` +\n  `<td>${r.daya_va} VA</td><td>${r.status}</td><td>${r.tindak_lanjut}</td></tr>`\n).join('');\n\nconst html = `<p>Rekap SPJBTL ${tanggal}</p>\n<p>Total: ${rows.length} | Lengkap: ${lengkap} | Perlu tindak lanjut: ${perlu}</p>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\n<tr><th>No. Agenda</th><th>Nama</th><th>Layanan</th><th>Daya</th><th>Status</th><th>Tindak Lanjut</th></tr>\n${baris}</table>`;\n\nreturn [{ json: {\n  total: rows.length, lengkap, perlu_tindak_lanjut: perlu,\n  subject: `Rekap SPJBTL ${tanggal}: ${perlu} perlu tindak lanjut`,\n  html,\n} }];;"
      },
